{
    "name": "vidual/openconsent",
    "type": "typo3-cms-extension",
    "description": "Cookie banner for Google Consent Mode v2 (Basic): one decision, Accept or Decline. Loads Google Tag Manager only after consent.",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/vidual-labs/openconsent",
    "authors": [
        {
            "name": "vidual",
            "homepage": "https://vidual.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.0"
    },
    "autoload": {
        "psr-4": {
            "Vidual\\OpenConsent\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "openconsent"
        }
    }
}
